# Copy to .env and change every "change_me" value before sharing the stack.
# docker compose reads this file automatically.

# --- MySQL (one server, one database per service; see app/db/registry.py) ---
MYSQL_ROOT_PASSWORD=local_root_password_change_me

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=observability_dev
RABBITMQ_DEFAULT_PASS=local_rabbit_password_change_me

# --- Service-to-service secret (gateway/query/rca/... trust only this token) ---
INTERNAL_API_TOKEN=local_internal_token_change_me

# --- Telemetry producers authenticate with one of these API keys (comma separated) ---
INGESTION_API_KEYS=local_ingest_key_change_me
# Key the instrumented services use when SENDING telemetry (must be one of the above)
INGESTION_API_KEY=local_ingest_key_change_me

# --- Console login (JWT). An empty password disables that account. ---
JWT_SECRET=local_jwt_secret_change_me_to_a_long_random_string
JWT_TTL_MINUTES=60
CONSOLE_ADMIN_USER=admin
CONSOLE_ADMIN_PASSWORD=admin_password_change_me
CONSOLE_ANALYST_USER=analyst
CONSOLE_ANALYST_PASSWORD=analyst_password_change_me
CONSOLE_VIEWER_USER=viewer
CONSOLE_VIEWER_PASSWORD=viewer_password_change_me

# --- Request limits ---
MAX_REQUEST_BYTES=1048576
MAX_BATCH_EVENTS=500

# --- Timeouts / retries ---
DOWNSTREAM_TIMEOUT_SECONDS=5
DOWNSTREAM_MAX_ATTEMPTS=3
GATEWAY_TIMEOUT_SECONDS=8

# --- Trace processing ---
TRACE_COMPLETION_WAIT_SECONDS=30
SLOW_SPAN_THRESHOLD_MS=500
SLOW_TRACE_THRESHOLD_MS=1000

# --- Metrics / alert thresholds (can be overridden at runtime via PUT /api/v1/alerts/rules) ---
METRIC_BUCKET_SECONDS=60
ALERT_MIN_SAMPLES=5
ALERT_ERROR_RATE_PERCENT=20
ALERT_AVG_LATENCY_MS=500
ALERT_P95_LATENCY_MS=1000
ALERT_REQUEST_VOLUME=1000
ALERT_COOLDOWN_SECONDS=300

# --- Sample application / failure scenarios ---
# normal | slow_payment | payment_failure | notification_timeout |
# invalid_downstream_response | intermittent_unavailability
DEFAULT_FAILURE_SCENARIO=normal
SLOW_PAYMENT_SECONDS=2
INTERMITTENT_FAILURE_RATE=0.5

LOG_LEVEL=INFO
