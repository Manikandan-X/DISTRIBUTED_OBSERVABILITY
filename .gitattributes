# Normalise line endings so Windows (CRLF) and Linux containers agree.
* text=auto

# Files that run inside Linux containers must keep LF
*.py            text eol=lf
*.ts            text eol=lf
*.tsx           text eol=lf
*.json          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.ini           text eol=lf
*.mako          text eol=lf
*.conf          text eol=lf
*.md            text eol=lf
*.txt           text eol=lf
Dockerfile      text eol=lf
.dockerignore   text eol=lf
.gitignore      text eol=lf

# Windows script
*.ps1           text eol=crlf

# Binary
*.png  binary
*.jpg  binary
*.ico  binary
*.zip  binary
